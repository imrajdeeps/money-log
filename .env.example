# Copy this file to .env.local for local runs. On GitHub, set the same two names as repository
# VARIABLES (Settings -> Secrets and variables -> Actions -> Variables) so the deploy workflow can build with them.
#
# Both values are PUBLIC: they end up inside the web page. They are safe only because the database access
# rules in supabase/schema.sql are in place. NEVER put the service_role / secret key here.
#
# Leave both empty to run in "local only" mode (no cloud sync).
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
