{
  "name": "money-log",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "description": "Money Log: log payments in seconds and see the month against your plan. Installable web app (PWA).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "e2e:build": "VITE_SUPABASE_URL=http://localhost:54380 VITE_SUPABASE_KEY=test-key vite build --outDir dist-e2e",
    "e2e:serve": "node tests/support/serve-e2e.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-virtual": "3.14.26",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "1.169.0",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
